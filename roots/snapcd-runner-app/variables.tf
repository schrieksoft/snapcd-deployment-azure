variable "cluster_host" {
  sensitive = true
}
variable "cluster_ca_certificate" {
  sensitive = true
}
variable "cluster_token" {
  sensitive = true
}
variable "chart_version" {
  description = "Version of the charts at oci://ghcr.io/schrieksoft/charts."
}
variable "name" {
  description = "Name of the Snap CD Runner: its Kubernetes namespace, release and service account."
}
variable "server_url" {
  description = "Server URL as the Runner reaches it inside the cluster."
}
variable "snapcd_runner_client_secret" {
  description = "Client secret generated by snapcd_server_app. Unused with a Key Vault."
  default     = ""
  sensitive   = true
}

variable "tenant_id" {}
variable "key_vault_enabled" {
  description = "Read secrets from the Key Vaults. False uses the ones generated in snapcd_server_app and here."
  default     = false
}
variable "snapcd_runner_workload_identity_client_id" {}

// Key Vault mode: set by the infra and infra-config Modules.
variable "snapcd_server_akv_url" {
  default = ""
}
variable "snapcd_runner_client_secret_reference" {
  default = ""
}
variable "snapcd_runner_akv_name" {
  default = ""
}
variable "snapcd_runner_ssh_key_secret_name" {
  default = ""
}
variable "snapcd_runner_ssh_public_key_openssh" {
  default = ""
}
