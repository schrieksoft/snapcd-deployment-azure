variable "cluster_host" {
  sensitive = true
}
variable "cluster_ca_certificate" {
  sensitive = true
}
variable "cluster_token" {
  sensitive = true
}
variable "chart_version" {
  description = "Version of the charts at oci://ghcr.io/schrieksoft/charts."
}
variable "namespace" {
  default = "snapcd-agent"
}
variable "server_url" {
  description = "Server URL as the Agent reaches it inside the cluster."
}
variable "snapcd_agent_client_secret" {
  description = "Client secret generated by snapcd_server_app. Unused with a Key Vault."
  default     = ""
  sensitive   = true
}
variable "claude_oauth_token" {
  description = "Claude credential for the Agent's sidecar. Set this or claude_api_key."
  default     = ""
  sensitive   = true
}
variable "claude_api_key" {
  default   = ""
  sensitive = true
}

// Key Vault mode: set by snapcd_server_infra_config and snapcd_agent_infra.
variable "tenant_id" {
  default = ""
}
variable "snapcd_server_akv_url" {
  default = ""
}
variable "snapcd_agent_client_secret_reference" {
  default = ""
}
variable "snapcd_agent_workload_identity_client_id" {
  default = ""
}
