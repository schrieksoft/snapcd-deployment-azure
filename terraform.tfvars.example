bootstrap_snapcd_client_id       = ""
bootstrap_snapcd_client_secret   = ""
bootstrap_snapcd_organization_id = ""

bootstrap_runner_name    = ""
bootstrap_stack_name     = "demo"
bootstrap_namespace_name = "platform"

name = "platform"

tenant_id               = ""
subscription_id         = ""
location                = "eastus2"
administrator_object_id = ""

# Optional: publish the gateway in an existing Azure DNS zone as <dns_record_name>.<dns_zone_name>
dns_zone_name                = ""
dns_zone_resource_group_name = ""
dns_record_name              = "snapcd"

# Optional: the Agent sidecar's credentials, in an existing Key Vault filled by hand
backend_akv_name                = ""
backend_akv_resource_group_name = ""
claude_credential               = "None" # None, OAuthToken or ApiKey
claude_oauth_token_secret_name  = "snapcd-agent-claude-code-oauth-token"
anthropic_api_key_secret_name   = "snapcd-agent-anthropic-api-key"
github_token_enabled            = false
github_token_secret_name        = "snapcd-agent-github-token"


# Message bus of the Snap CD Server: SqlServer or AzureServiceBus
snapcd_server_bus_type = "SqlServer"
